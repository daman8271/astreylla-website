# Copy this to .env in the augmont-diamonds/ directory and fill in real values.
# NEVER commit .env to GitHub.
#
# Every key listed here is read by the application. Verify with:
#   cd augmont-diamonds
#   grep -RhoE "process\.env\.[A-Z_][A-Z0-9_]*" app server | sort -u
# (DATABASE_URL/DIRECT_URL are read by prisma/schema.prisma's datasource
#  block directly, not via process.env, so they don't appear in that grep.)

# ─── Shopify app (from Partner Dashboard) ───────────────────────────────────
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# OAuth scopes — keep in sync with augmont-diamonds/shopify.app.toml [access_scopes].scopes
SCOPES=read_products

# Public app URL (Railway domain in production).
SHOPIFY_APP_URL=

# Optional custom domain to allowlist for the Shopify session adapter.
SHOP_CUSTOM_DOMAIN=

# ─── Database (Supabase Postgres) ───────────────────────────────────────────
# Runtime: pooled URL — MUST include ?pgbouncer=true&connection_limit=1
# (otherwise Prisma's prepared-statement cache collides with PgBouncer's
#  recycled backends; see CLAUDE.md "Prisma + Supabase PgBouncer rule").
DATABASE_URL=

# Migrations: direct URL — MUST NOT have the pgbouncer flag, since
# `prisma migrate` requires real prepared statements on a non-pooled connection.
DIRECT_URL=

# ─── Augmont LGD (Payal's diamond API) ──────────────────────────────────────
AUGMONT_BASE_URL=https://api.uatlgd.augmont.com/api/v1
PAYAL_API_USERNAME=
PAYAL_API_PASSWORD=

# ─── Server runtime ─────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Hostname used by the Shopify session-token verifier for iss claim validation
# (server/middleware/auth.js). In production set this to the Railway hostname.
HOST=localhost

# Internal URL the Remix admin uses to call the Express API.
# In production both processes run on the same Railway service after Phase C C1,
# so this can be http://localhost:$PORT.
EXPRESS_API_URL=http://localhost:4000
