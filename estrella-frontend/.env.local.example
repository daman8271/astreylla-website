# Shopify Storefront API — populate when adding real product queries.
# Token obtained via Shopify Admin → Apps → Develop apps → Storefront API.
SHOPIFY_STORE_DOMAIN=trial-shop-sqxnl71f.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=

# Diamond widget API (Express server on Railway).
# /api/widget/* in this Next app proxies to this URL — keeps the browser
# same-origin and avoids CORS. Override locally only if pointing the widget
# at a different upstream.
NEXT_PUBLIC_DIAMOND_WIDGET_API_URL=https://claude-code-max-shopify-app-production.up.railway.app
