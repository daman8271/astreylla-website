generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Required by @shopify/shopify-app-session-storage-prisma — do not remove fields.
// `shop` is intentionally NOT @unique — Shopify creates multiple sessions per
// shop (offline + online + multiple users + refresh-token rotation). The
// adapter's Prisma-recommended shape is a plain string with an index for
// lookup performance. Merchant identity is keyed on Merchant.shopId @unique
// instead, which is the canonical "one merchant per shop" handle.
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
  @@map("sessions")
}

// Merchant ↔ Session is a soft join on shop string — code looks up each
// table independently. Removing the FK to Session.shop unblocks the
// Session.shop @unique drop above (multiple sessions per shop now allowed).
// Merchant.shopId remains @unique so it stays the canonical FK target for
// Order, Subscription, and CartItem.
model Merchant {
  id            String  @id @default(cuid())
  shopId        String  @unique
  plan          String  @default("free")
  isActive      Boolean @default(true)
  widgetEnabled Boolean @default(false)

  orders        Order[]
  subscriptions Subscription[]
  cartItems     CartItem[]

  @@map("merchants")
}

model Order {
  id                   String    @id @default(cuid())
  shop                 String
  customerEmail        String
  customerName         String?
  diamondId            String
  diamondDetails       Json
  status               String    @default("pending")
  shopifyOrderId       String?
  payalOrderId         String?
  augmontInvoiceNumber String?   @unique
  augmontOrderId       String?
  cartItemIds          Json?
  orderNote            String?
  statusLastChecked    DateTime?
  createdAt            DateTime  @default(now())

  merchant Merchant @relation(fields: [shop], references: [shopId])

  @@map("orders")
}

model CartItem {
  id                String   @id @default(cuid())
  shop              String
  sessionId         String
  augmontCartItemId String?
  diamondId         String
  diamondDetails    Json
  status            String   @default("active")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  merchant Merchant @relation(fields: [shop], references: [shopId])

  @@index([shop, sessionId, status])
  @@index([augmontCartItemId])
  @@map("cart_items")
}

model Subscription {
  id              String    @id @default(cuid())
  shop            String
  shopifyChargeId String    @unique
  planName        String
  status          String
  trialEndsAt     DateTime?
  billingOn       DateTime?
  createdAt       DateTime  @default(now())

  merchant Merchant @relation(fields: [shop], references: [shopId])

  @@map("subscriptions")
}
