# Copy this to .env and fill in real values.
# NEVER commit .env to GitHub.
#
# Verify keys referenced in code:
#   grep -RhoE "process\.env\.[A-Z_][A-Z0-9_]*" app server | sort -u
# (DATABASE_URL/DIRECT_URL are read by prisma/schema.prisma's datasource
#  block directly, not via process.env, so they don't appear in that grep.)
#
# In production: set every key below via the Railway dashboard or
# `railway variables --set ...`. The .env file is local-only — Railway never
# reads it.

# ─── Required (set locally AND on Railway) ──────────────────────────────────

# Shopify app credentials (Partner Dashboard)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# OAuth scopes — keep in sync with shopify.app.toml [access_scopes].scopes
SCOPES=read_products

# Public app URL.
# Local: http://localhost:4000 for direct `node server/index.js`.
# `shopify app dev` overrides this with a tunnel URL automatically.
# Production: the Railway public domain (e.g. https://x.up.railway.app).
SHOPIFY_APP_URL=http://localhost:4000

# Hostname for Shopify session-token iss-claim validation
# (server/middleware/auth.js). Production: the Railway hostname (no protocol).
HOST=localhost

# Database (Supabase Postgres)
# DATABASE_URL: pooled — MUST include ?pgbouncer=true&connection_limit=1
# (CLAUDE.md "Prisma + Supabase PgBouncer rule").
DATABASE_URL=
# DIRECT_URL: direct — MUST NOT have the pgbouncer flag (prisma migrate
# requires real prepared statements on a non-pooled connection).
DIRECT_URL=

# Augmont LGD (Payal's diamond API)
AUGMONT_BASE_URL=https://api.uatlgd.augmont.com/api/v1
PAYAL_API_USERNAME=
PAYAL_API_PASSWORD=

# Runtime
NODE_ENV=development

# ─── Auto-provided in production ────────────────────────────────────────────
# Railway sets PORT at boot. The local fallback below is for direct
# `node server/index.js` invocation.
PORT=4000

# ─── Optional ───────────────────────────────────────────────────────────────

# Internal URL the Remix admin uses to call Express. Both processes run on
# the same Railway service, so localhost works in prod and locally.
EXPRESS_API_URL=http://localhost:4000

# Custom merchant storefront domain (non-myshopify.com). Leave blank unless
# the merchant has wired a vanity domain to their store.
SHOP_CUSTOM_DOMAIN=

# Tuning knobs (uncomment to override defaults — see server/services/payalApi.js):
# AUGMONT_CACHE_TTL_MS=600000      # P1 cache TTL (default 10 min)
# AUGMONT_TIMEOUT_MS=30000         # P2 upstream timeout (default 30s — bumped May 4, 2026 since prod unfiltered queries take ~21s)
